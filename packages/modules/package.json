{
  "name": "@gitwork/modules",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional admin feature modules. Each is a factory you switch on in admin.config.ts.",
  "exports": {
    ".": "./src/index.ts",
    "./dashboard": "./src/dashboard/index.tsx",
    "./users": "./src/users/index.tsx",
    "./rbac": "./src/rbac/index.tsx",
    "./reports": "./src/reports/index.tsx",
    "./coupons": "./src/coupons/index.tsx",
    "./content": "./src/content/index.tsx",
    "./notifications": "./src/notifications/index.tsx",
    "./theme-builder": "./src/theme-builder/index.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@gitwork/admin-shell": "workspace:*",
    "@gitwork/data": "workspace:*",
    "@gitwork/tokens": "workspace:*",
    "@gitwork/ui": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "fflate": "0.8.3",
    "react-hook-form": "7.92.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@gitwork/config": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "jsdom": "31.0.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
