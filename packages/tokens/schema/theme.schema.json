      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "extends": {
      "description": "Inherit everything from another theme id, then override",
      "type": "string"
    },
    "modes": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "supported": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ]
          }
        }
      },
      "required": [
        "default",
        "supported"
      ],
      "additionalProperties": false
    },
