          "properties": {
            "family": {
              "type": "string",
              "minLength": 1,
              "description": "Font family name, e.g. Barlow"
            },
            "source": {
              "type": "string",
              "enum": [
                "google",
                "fontshare",
                "local",
                "system"
              ],
              "description": "google / fontshare load a stylesheet; local expects files under the app's public/fonts; system loads nothing"
            },
            "weights": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 100,
                "maximum": 900
              }
            },
            "fallback": {
              "description": "CSS fallback stack appended after the family",
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "number"
                  },
                  "style": {
                    "type": "string"
                  }
                },
                "required": [
                  "src",
                  "weight"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "family",
            "source"
          ],
          "additionalProperties": false
